# Normalize line endings: LF in the repo and on checkout, on every platform.
# The app deploys to Linux (Render / Vercel), so LF is the source of truth.
* text=auto eol=lf

# Explicitly text
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.mako  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sh    text eol=lf
*.env.example text eol=lf
Dockerfile   text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Binary — never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.pdf   binary
