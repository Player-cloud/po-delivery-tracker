# Copy to .env and fill in for local development. Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/po_tracking

SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads

# --- Email ---
# smtp   -> local dev, points at Mailhog (docker compose)
# resend -> production (RESEND_API_KEY + verified sender domain)
# brevo  -> production alternative (BREVO_API_KEY + verified sender)
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_ADDRESS=po-tracking@example.com
SMTP_FROM_NAME=PO Delivery Tracker
# RESEND_API_KEY=
# BREVO_API_KEY=

# --- Reminders (M1) ---
# Secret the daily scheduler must send as `Authorization: Bearer <...>` when it
# calls POST /api/v1/internal/run-reminders. Generate a long random string per env.
CRON_SECRET=dev-cron-secret-change-me
# Used to build the "open this PO line" link in reminder emails.
FRONTEND_BASE_URL=http://localhost:3000
# Safety net for a line that somehow still has no active assignee (Assigned To is
# required, but old data / deactivated users can slip through). Unset = log-and-skip.
# REMINDER_FALLBACK_EMAIL=ops@example.com
# Overdue escalation (PRD §14 Q3): assignee gets the daily overdue reminder for
# this many days, then it switches to REMINDER_ESCALATION_EMAIL.
REMINDER_OVERDUE_ESCALATION_DAYS=7
# REMINDER_ESCALATION_EMAIL=manager@example.com
# Per-run guardrails (keep a single pass within the host timeout / provider daily cap).
REMINDER_BATCH_SIZE=500
REMINDER_MAX_EMAILS_PER_RUN=90
